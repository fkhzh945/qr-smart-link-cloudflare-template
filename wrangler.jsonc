      "/api/*",
      "/q/*",
      "/public/*",
      "/health*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr-smart-link-lite-db",
      "database_id": "00000000000000000000000000000000",
      "migrations_dir": "./migrations"
    }
  ]
}

