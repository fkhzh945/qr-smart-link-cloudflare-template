# Deploy to Cloudflare can ask for these three Worker secrets during installation.
# Each value must be unique and randomly generated. NEVER use the example text below.
# The deployment owner needs SETUP_TOKEN once to claim the first administrator account.
SETUP_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_32_BYTE_VALUE
SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_48_BYTE_VALUE
ACTIVATION_SECRET=REPLACE_WITH_ANOTHER_DIFFERENT_RANDOM_48_BYTE_VALUE
